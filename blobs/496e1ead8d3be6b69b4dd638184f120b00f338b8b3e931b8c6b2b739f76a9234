      <div class="page-subtitle" id="toolDesc"></div>
      <div id="toolNote"></div>
      <div class="tool-box" id="toolForm"></div>
      <div class="result-box" id="toolResult">Hasil akan muncul di sini...</div>
    </div>

    <div class="page" id="page-ai-worker">
      <button class="back-btn" onclick="goBack()">‹ Kembali</button>
      <div class="page-title" id="aiTitle">AI</div>
      <div class="page-subtitle" id="aiDesc"></div>
      <div class="tool-box">
        <label>Tulis pesan:</label>
        <textarea id="aiInput" rows="3" placeholder="Hai..."></textarea>
        <button class="btn-run" id="aiSendBtn" onclick="sendAIChat()">Kirim 🚀</button>
      </div>
      <div class="result-box" id="aiResult">Balasan akan muncul di sini...</div>
    </div>

  </div>

  <div id="bottomNav">
    <div class="nav-item active" data-page="home" onclick="navTo('home')">
      <div class="nav-icon">🏠</div><div class="nav-label">Home</div>
    </div>
    <div class="nav-item" data-page="download" onclick="navTo('download')">
      <div class="nav-icon">⬇️</div><div class="nav-label">Download</div>
    </div>
    <div class="nav-item" data-page="tools" onclick="navTo('tools')">
      <div class="nav-icon">🛠️</div><div class="nav-label">Tools</div>
    </div>
    <div class="nav-item" data-page="ai" onclick="navTo('ai')">
      <div class="nav-icon">🤖</div><div class="nav-label">AI</div>
    </div>
  </div>
</div>

<script>
  /* ============ TOGGLE PASSWORD ============ */
  function togglePass(inputId, btn) {
    const inp = document.getElementById(inputId);
    if (inp.type === 'password') { inp.type = 'text'; btn.textContent = '🙈'; }
    else { inp.type = 'password'; btn.textContent = '👁'; }
  }

  /* ============ NAV ============ */
  let navHistory = ['home'];
  let currentUser = '';

  function navTo(page) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    const target = document.getElementById('page-' + page);
    if (target) target.classList.add('active');

    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    const navBtn = document.querySelector(`.nav-item[data-page="${page}"]`);
    if (navBtn) navBtn.classList.add('active');

    if (navHistory[navHistory.length - 1] !== page) navHistory.push(page);
    document.getElementById('content').scrollTop = 0;
  }

  function goBack() {
    navHistory.pop();
    const prev = navHistory[navHistory.length - 1] || 'home';
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page-' + prev).classList.add('active');
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    const navBtn = document.querySelector(`.nav-item[data-page="${prev}"]`);
    if (navBtn) navBtn.classList.add('active');
    document.getElementById('content').scrollTop = 0;
  }

  /* ============ AUTH ============ */
  function switchTab(tab, btn) {
    document.querySelectorAll('.tabs button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.form-section').forEach(f => f.classList.remove('active'));
    document.getElementById(tab === 'login' ? 'loginForm' : 'registerForm').classList.add('active');
  }

  function doRegister() {
    const u = document.getElementById('regUser').value.trim();
    const p = document.getElementById('regPass').value;
    const p2 = document.getElementById('regPass2').value;
    const msg = document.getElementById('regMsg');
    if (!u || !p || !p2) { msg.textContent = 'Isi semua field!'; return; }
    if (p !== p2) { msg.textContent = 'Password tidak sama!'; return; }
    if (p.length < 4) { msg.textContent = 'Password minimal 4 karakter!'; return; }
    localStorage.setItem('xyro_user_' + u, p);
    msg.style.color = '#00ff99';
    msg.textContent = 'Akun berhasil dibuat! Silakan login.';
    setTimeout(() => {
      document.querySelectorAll('.tabs button')[0].click();
      msg.textContent = ''; msg.style.color = '#ff5577';
    }, 1200);
  }

  function doLogin() {
    const u = document.getElementById('loginUser').value.trim();
    const p = document.getElementById('loginPass').value;
    const msg = document.getElementById('loginMsg');
    if (!u || !p) { msg.textContent = 'Isi username & password!'; return; }
    const saved = localStorage.getItem('xyro_user_' + u);
    if (saved && saved === p) { msg.textContent = ''; playIntro(u); }
    else { msg.textContent = 'Username atau password salah!'; }
  }

  function playIntro(username) {
    document.getElementById('authBox').style.display = 'none';
    document.getElementById('videoScreen').style.display = 'block';
    const vid = document.getElementById('introVideo');
    vid.currentTime = 0;
    vid.play().catch(e => console.log('Autoplay gagal:', e));
    vid.onended = () => showApp(username);
  }

  function skipVideo() {
    document.getElementById('introVideo').pause();
    showApp(document.getElementById('loginUser').value.trim());
  }

  function showApp(username) {
    currentUser = username;
    document.getElementById('videoScreen').style.display = 'none';
    document.getElementById('app').style.display = 'flex';
    document.getElementById('userName').textContent = username;
    document.getElementById('userAvatar').textContent = username.charAt(0).toUpperCase();
    navTo('home');
  }

  function logout() {
    document.getElementById('app').style.display = 'none';
    document.getElementById('authBox').style.display = 'flex';
    document.getElementById('loginUser').value = '';
    document.getElementById('loginPass').value = '';
    navHistory = ['home'];
    currentUser = '';
  }

  /* ============ TOOLS ============ */
  const BASE = 'https://api.synoxcloud.xyz';
  const KEY = 'hanzsecretkey';

  const TOOL_DEFS = {
    web2zip: { title: '🌐 Web to ZIP', desc: 'Convert website jadi ZIP',
      fields: [{ id: 'url', label: 'URL Website', placeholder: 'https://example.com' }],
      build: (v) => `${BASE}/tools/web2zip?apikey=${KEY}&url=${encodeURIComponent(v.url)}` },

    tiktok: { title: '🎵 TikTok Downloader', desc: 'Download video TikTok',
      fields: [{ id: 'url', label: 'URL TikTok', placeholder: 'https://vt.tiktok.com/xxxx/' }],
      build: (v) => `${BASE}/download/tiktok?apikey=${KEY}&url=${encodeURIComponent(v.url)}` },

    youtube: { title: '▶️ YouTube Downloader', desc: 'Download video/audio YouTube',
      fields: [{ id: 'url', label: 'URL YouTube', placeholder: 'https://youtu.be/xxxx' }],
      build: (v) => `${BASE}/download/youtube?apikey=${KEY}&url=${encodeURIComponent(v.url)}` },

    spotify: { title: '🎧 Spotify Downloader', desc: 'Download lagu Spotify',
      fields: [{ id: 'url', label: 'URL Spotify', placeholder: 'https://open.spotify.com/track/xxxx' }],
      build: (v) => `${BASE}/download/spotify?apikey=${KEY}&url=${encodeURIComponent(v.url)}` },

    cuaca: { title: '🌤️ Cuaca', desc: 'Info cuaca kota',
      fields: [{ id: 'city', label: 'Nama Kota', placeholder: 'Jakarta' }],
      build: (v) => `${BASE}/tools/cuaca?apikey=${KEY}&city=${encodeURIComponent(v.city)}` },

    meme: { title: '😂 Random Meme', desc: 'Meme random tiap klik',
      fields: [],
      build: () => `${BASE}/random/meme?apikey=${KEY}` },

    /* ===== AM Send: cuma email ===== */
    amsend: {
      title: '📧 AM — Send Email Link',
      desc: 'Kirim link verifikasi ke gmail',
      note: '📨 Masukin <b>email Alight Motion</b> kamu. Link verifikasi bakal dikirim ke gmail. Copy link-nya, terus pakai di menu <b>AM — Verify & Activate</b>.',
      fields: [{ id: 'email', label: 'Email Alight Motion', placeholder: 'user@gmail.com' }],
      build: (v) => `${BASE}/premium/amverify?apikey=${KEY}&email=${encodeURIComponent(v.email)}`
    },

    /* ===== AM Verify: email + link ===== */
    amverify: {
      title: '🎬 AM — Verify & Activate',
      desc: 'Aktivasi pakai oobCode dari email',
      note: '🔗 Tempel <b>link oobCode</b> yang kamu terima di gmail (dari step Send Email Link). Link bentuknya kaya <code>https://alightcreative.com/?oobCode=xxxxx</code>.',
      fields: [
        { id: 'email', label: 'Email Alight Motion', placeholder: 'user@gmail.com' },
        { id: 'link',  label: 'Link Verifikasi (oobCode)', placeholder: 'https://alightcreative.com/?oobCode=xxxxx' }
      ],
      build: (v) => `${BASE}/premium/amverify?apikey=${KEY}&email=${encodeURIComponent(v.email)}&link=${encodeURIComponent(v.link)}`
    }
  };

  let currentTool = null;

  function openTool(key) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    document.getElementById('page-tool-worker').classList.add('active');
    navHistory.push('tool-worker');
    currentTool = key;
    const def = TOOL_DEFS[key];
    document.getElementById('toolTitle').textContent = def.title;
    document.getElementById('toolDesc').textContent = def.desc;

    // note opsional
    const noteEl = document.getElementById('toolNote');
    if (def.note) {
      noteEl.innerHTML = `<div class="info-note">${def.note}</div>`;
    } else {
      noteEl.innerHTML = '';
    }

    const form = document.getElementById('toolForm');
    if (def.fields.length === 0) {
      form.innerHTML = `<button class="btn-run" id="toolRunBtn" onclick="runTool()">Proses 🚀</button>`;
    } else {
      form.innerHTML = def.fields.map(f =>
        `<label>${f.label}</label><input type="text" id="tf_${f.id}" placeholder="${f.placeholder}">`
      ).join('') + `<button class="btn-run" id="toolRunBtn" onclick="runTool()">Proses 🚀</button>`;
    }

    document.getElementById('toolResult').textContent = 'Hasil akan muncul di sini...';
    document.getElementById('content').scrollTop = 0;
  }

  async function runTool() {
    if (!currentTool) return;
    const def = TOOL_DEFS[currentTool];
    const values = {};
    (def.fields || []).forEach(f => values[f.id] = document.getElementById('tf_' + f.id).value.trim());
    for (const f of (def.fields || [])) {
      if (!values[f.id]) { alert('Isi ' + f.label + ' dulu!'); return; }
    }
    // validasi email kalau ada field email
    if (values.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email)) {
      alert('Format email salah!'); return;
    }
    // validasi link oobCode kalau ada field link
    if (values.link && !/oobCode=/.test(values.link)) {
      alert('Link harus mengandung "?oobCode="!'); return;
    }

    const url = def.build(values);
    const btn = document.getElementById('toolRunBtn');
    const out = document.getElementById('toolResult');
    btn.disabled = true;
    out.innerHTML = '<span class="loading">⏳ Memproses... sabar master</span>';
    try {
      const res = await fetch(url);
      const text = await res.text();
      let data;
      try { data = JSON.parse(text); } catch(e) { data = text; }
      out.textContent = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
      renderLinksIfAny(data, out);
    } catch (err) {
      out.textContent = '❌ Error: ' + err.message;
    } finally { btn.disabled = false; }
  }

  function renderLinksIfAny(data, container) {
    const found = [];
    function walk(obj) {
      if (!obj) return;
      if (typeof obj === 'string') {
        if (/^https?:\/\//.test(obj) && /\.(mp4|mp3|jpg|jpeg|png|zip|webm|m4a|gif|webp)/i.test(obj)) found.push(obj);
      } else if (typeof obj === 'object') {
        for (const k in obj) walk(obj[k]);
      }
    }
    walk(data);
    if (found.length) {
      const images = found.filter(l => /\.(jpg|jpeg|png|gif|webp)/i.test(l));
      const others = found.filter(l => !/\.(jpg|jpeg|png|gif|webp)/i.test(l));
      let html = '';
      if (images.length) {
        html += images.map(l => `<img src="${l}" alt="preview" onerror="this.style.display='none'">`).join('');
      }
      if (others.length) {
        html += others.map(l => `<a href="${l}" target="_blank">🔗 ${l}</a>`).join('<br>');
      }
      if (html) {
        container.innerHTML += `<div style="margin-top:10px;padding-top:10px;border-top:1px solid rgba(180,0,255,0.3)">${html}</div>`;
      }
    }
  }

  /* ============ AI ============ */
  const AI_DEFS = { novaai: { title: '✨ Nova AI', desc: 'Chat AI serba bisa', endpoint: 'novaai' } };
  let currentAI = null;

  function openAI(key) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    document.getElementById('page-ai-worker').classList.add('active');
    navHistory.push('ai-worker');
    currentAI = key;
    const def = AI_DEFS[key];
    document.getElementById('aiTitle').textContent = def.title;
    document.getElementById('aiDesc').textContent = def.desc;
    document.getElementById('aiResult').textContent = 'Balasan akan muncul di sini...';
    document.getElementById('content').scrollTop = 0;
  }

  async function sendAIChat() {
    if (!currentAI) return;
    const input = document.getElementById('aiInput').value.trim();
    const out = document.getElementById('aiResult');
    const btn = document.getElementById('aiSendBtn');
    if (!input) { alert('Tulis pesan dulu!'); return; }
    btn.disabled = true;
    out.innerHTML = '<span class="loading">⏳ Lagi mikir...</span>';
    try {
      const res = await fetch(`${BASE}/ai-chat/${AI_DEFS[currentAI].endpoint}?apikey=${KEY}&text=${encodeURIComponent(input)}`);
      const data = await res.json();
      let reply = '❓ Nggak ada balasan.';
      if (data && data.result) {
        reply = typeof data.result === 'string' ? data.result : (data.result.reply || JSON.stringify(data.result));
      } else if (data) reply = JSON.stringify(data);
      out.innerHTML = `<b style="color:#00e5ff">Kamu:</b> ${escapeHtml(input)}\n\n<b style="color:#c800ff">AI:</b> ${escapeHtml(reply)}`;
    } catch (err) {
      out.textContent = '❌ Error: ' + err.message;
    } finally { btn.disabled = false; }
  }

  /* ============ UTIL ============ */
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      if (document.activeElement.id === 'aiInput') { e.preventDefault(); sendAIChat(); }
    }
  });
</script>
