        </div>
        <div class="list-item" onclick="openTool('youtube')">
          <div class="ic">▶️</div><div><div class="t">YouTube</div><div class="d">Download video/audio</div></div>
        </div>
        <div class="list-item" onclick="openTool('spotify')">
          <div class="ic">🎧</div><div><div class="t">Spotify</div><div class="d">Download lagu</div></div>
        </div>
      </div>
    </div>

    <div class="page" id="page-tools">
      <div class="page-title">🛠️ Tools</div>
      <div class="page-subtitle">Tool utility buat kerjaan kamu</div>
      <div class="list">
        <div class="list-item" onclick="openTool('web2zip')">
          <div class="ic">🌐</div><div><div class="t">Web to ZIP</div><div class="d">Convert website jadi ZIP</div></div>
        </div>
        <div class="list-item" onclick="openTool('tiktok')">
          <div class="ic">🎵</div><div><div class="t">TikTok Downloader</div><div class="d">Download video TikTok</div></div>
        </div>
        <div class="list-item" onclick="openTool('youtube')">
          <div class="ic">▶️</div><div><div class="t">YouTube Downloader</div><div class="d">Download video/audio</div></div>
        </div>
        <div class="list-item" onclick="openTool('spotify')">
          <div class="ic">🎧</div><div><div class="t">Spotify Downloader</div><div class="d">Download lagu</div></div>
        </div>
        <div class="list-item" onclick="openTool('cuaca')">
          <div class="ic">🌤️</div><div><div class="t">Cuaca</div><div class="d">Info cuaca kota</div></div>
        </div>
        <div class="list-item" onclick="openTool('meme')">
          <div class="ic">😂</div><div><div class="t">Random Meme</div><div class="d">Meme random tiap klik</div></div>
        </div>
        <div class="list-item" onclick="openTool('amsend')">
          <div class="ic">📧</div><div><div class="t">AM — Send Email Link</div><div class="d">Kirim link verifikasi ke gmail</div></div>
        </div>
        <div class="list-item" onclick="openTool('amverify')">
          <div class="ic">🎬</div><div><div class="t">AM — Verify & Activate</div><div class="d">Aktivasi pakai oobCode dari email</div></div>
        </div>
      </div>
    </div>

    <div class="page" id="page-ai">
      <div class="page-title">🤖 AI</div>
      <div class="page-subtitle">Pilih AI yang mau dipakai</div>
      <div class="list">
        <div class="list-item" onclick="openAI('novaai')">
          <div class="ic">✨</div><div><div class="t">Nova AI</div><div class="d">Chat AI serba bisa</div></div>
        </div>
      </div>
    </div>

    <div class="page" id="page-tool-worker">
      <button class="back-btn" onclick="goBack()">‹ Kembali</button>
