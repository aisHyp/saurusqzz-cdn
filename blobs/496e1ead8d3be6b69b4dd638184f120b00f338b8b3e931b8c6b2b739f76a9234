<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>XyroPlay</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',-apple-system,sans-serif; -webkit-tap-highlight-color:transparent; }
  html, body { height:100%; }
  body {
    background:#0a0a0a;
    color:#fff; overflow-x:hidden;
    display:flex; flex-direction:column;
  }

  /* ============== AUTH ============== */
  #authBox {
    position:fixed; inset:0; z-index:500;
    display:flex; align-items:center; justify-content:center;
    background:#0a0a0a;
    padding:20px;
  }
  .auth-card {
    width:100%; max-width:400px;
    padding:40px 28px 32px;
    border-radius:22px;
    background:#141414;
    border:1px solid rgba(255,255,255,0.06);
    box-shadow:0 20px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.02) inset;
    animation:fadeIn .5s ease;
  }
  @keyframes fadeIn { from{opacity:0; transform:translateY(20px);} to{opacity:1; transform:translateY(0);} }

  .auth-avatar {
    width:88px; height:88px; border-radius:50%;
    margin:0 auto 16px;
    background: radial-gradient(circle, rgba(255,255,255,0.15), transparent 70%);
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 0 30px rgba(255,255,255,0.25);
  }
  .auth-avatar img {
    width:80px; height:80px; border-radius:50%;
    object-fit:cover;
    border:2px solid rgba(255,255,255,0.15);
    box-shadow:0 0 20px rgba(255,255,255,0.3);
  }

  .auth-title {
    text-align:center; font-size:26px; font-weight:800;
    letter-spacing:0.5px; margin-bottom:8px; color:#fff;
  }
  .auth-subtitle {
    text-align:center; font-size:13px; color:#8a8a8a; margin-bottom:26px;
  }

  .tabs {
    display:flex; padding:4px;
    background:#0a0a0a;
    border:1px solid rgba(255,255,255,0.08);
    border-radius:14px; margin-bottom:22px;
  }
  .tabs button {
    flex:1; padding:11px;
    background:transparent; border:none;
    color:#8a8a8a; font-size:14px; font-weight:600;
    cursor:pointer; transition:.25s; border-radius:10px;
  }
  .tabs button.active {
    background:#fff; color:#000;
    box-shadow:0 2px 10px rgba(255,255,255,0.15);
  }

  .input-label {
    display:block; text-align:center;
    font-size:10px; font-weight:700; letter-spacing:2px;
    color:#8a8a8a; text-transform:uppercase; margin-bottom:8px;
  }
  .input-wrap { position:relative; margin-bottom:18px; }
  .input-wrap input {
    width:100%; padding:15px 18px;
    background:#0a0a0a;
    border:1px solid rgba(255,255,255,0.1);
    border-radius:14px; color:#fff; font-size:14px;
    outline:none; transition:.25s;
  }
  .input-wrap input::placeholder { color:#666; }
  .input-wrap input:focus {
    border-color:rgba(255,255,255,0.35);
    background:#050505;
  }
  .input-wrap .eye-btn {
    position:absolute; right:12px; top:50%; transform:translateY(-50%);
    width:36px; height:36px;
    background:rgba(255,255,255,0.05);
    border:1px solid rgba(255,255,255,0.1);
    border-radius:10px; color:#ccc; font-size:15px;
    cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    transition:.2s;
  }
  .input-wrap .eye-btn:active { background:rgba(255,255,255,0.15); }

  .btn-main {
    width:100%; padding:16px; margin-top:6px;
    background:#fff; color:#000;
    border:none; border-radius:14px;
    font-size:15px; font-weight:700;
    cursor:pointer; transition:.25s; letter-spacing:0.3px;
  }
  .btn-main:hover { transform:scale(1.01); }
  .btn-main:active { transform:scale(0.98); background:#e6e6e6; }

  .auth-footer {
    text-align:center; font-size:11.5px;
    color:#6a6a6a; margin-top:20px; letter-spacing:0.2px;
  }
  .auth-footer b { color:#c8c8c8; font-weight:600; }

  .form-section { display:none; }
  .form-section.active { display:block; animation:fadeIn .3s ease; }
  .msg { text-align:center; font-size:12.5px; margin-top:12px; min-height:18px; color:#ff5577; }

  /* ============== VIDEO (FULLSCREEN) ============== */
  #videoScreen {
    position:fixed; inset:0; background:#000; display:none; z-index:999;
  }
  #videoScreen video {
    position:absolute; inset:0;
    width:100%; height:100%;
    object-fit:cover; display:block;
  }
  #skipBtn {
    position:absolute; bottom:40px; right:40px; z-index:1000;
    padding:12px 28px;
    border:1px solid rgba(255,255,255,0.5);
    background:rgba(0,0,0,0.5);
    color:#fff; border-radius:30px;
    font-size:14px; cursor:pointer; letter-spacing:1px;
    backdrop-filter:blur(6px); transition:.3s;
  }
  #skipBtn:hover { background:#c800ff; border-color:#c800ff; transform:scale(1.05); }

  /* ============== APP ============== */
  #app {
    display:none; flex-direction:column;
    height:100vh; max-width:520px; margin:0 auto; width:100%; position:relative;
  }
  #content {
    flex:1; overflow-y:auto;
    padding:16px 16px 100px;
    -webkit-overflow-scrolling:touch;
  }
  .page { display:none; animation:fadeIn .35s ease; }
  .page.active { display:block; }

  .banner-wrap {
    width:100%; border-radius:16px; overflow:hidden; margin-bottom:16px;
    border:1px solid rgba(180,0,255,0.4);
    box-shadow:0 0 25px rgba(200,0,255,0.35);
  }
  .banner-wrap img { width:100%; display:block; object-fit:cover; }

  .user-card {
    display:flex; align-items:center; gap:14px;
    padding:14px 16px; border-radius:14px;
    background:rgba(20,0,40,0.7);
    border:1px solid rgba(180,0,255,0.3);
    margin-bottom:16px;
  }
  .user-avatar {
    width:46px; height:46px; border-radius:50%;
    background:linear-gradient(135deg,#7a00ff,#00e5ff);
    display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:19px; flex-shrink:0;
  }
  .user-info h3 { font-size:15px; margin-bottom:2px; }
  .user-info p { font-size:11px; color:#aaa; }

  .page-title {
    font-size:18px; font-weight:600; margin-bottom:4px;
    background:linear-gradient(90deg,#c800ff,#00e5ff);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
  }
  .page-subtitle { font-size:12px; color:#888; margin-bottom:18px; }

  .list { display:flex; flex-direction:column; gap:10px; }
  .list-item {
    padding:14px 16px; border-radius:12px;
    background:rgba(20,0,40,0.7);
    border:1px solid rgba(180,0,255,0.25);
    cursor:pointer; transition:.25s;
    display:flex; align-items:center; gap:12px;
  }
  .list-item:active {
    border-color:#c800ff;
    box-shadow:0 0 15px rgba(200,0,255,0.35);
    transform:scale(0.98);
  }
  .list-item .ic { font-size:20px; width:26px; text-align:center; }
  .list-item .t { font-size:14px; font-weight:600; }
  .list-item .d { font-size:11px; color:#888; margin-top:2px; }

  .tool-box {
    padding:16px; border-radius:14px;
    background:rgba(20,0,40,0.7);
    border:1px solid rgba(180,0,255,0.3);
    margin-bottom:14px;
  }
  .tool-box label { display:block; font-size:12px; color:#aaa; margin-bottom:6px; }
  .tool-box input, .tool-box textarea {
    width:100%; padding:11px 13px; border-radius:10px;
    background:rgba(255,255,255,0.05);
    border:1px solid rgba(180,0,255,0.25);
    color:#fff; outline:none; font-size:13px; margin-bottom:12px;
    font-family:inherit; resize:vertical;
  }
  .tool-box input:focus, .tool-box textarea:focus { border-color:#c800ff; }
  .btn-run {
    width:100%; padding:11px; border:none; border-radius:10px;
    background:linear-gradient(90deg,#7a00ff,#c800ff);
    color:#fff; font-weight:600; font-size:14px;
    cursor:pointer; transition:.3s;
  }
  .btn-run:hover { transform:scale(1.02); box-shadow:0 0 18px rgba(200,0,255,0.5); }
  .btn-run:disabled { opacity:0.5; cursor:not-allowed; transform:none; }

  .result-box {
    padding:14px; border-radius:12px;
    background:rgba(0,0,0,0.5);
    border:1px solid rgba(180,0,255,0.3);
    font-size:12.5px; line-height:1.5; color:#ddd;
    white-space:pre-wrap; word-break:break-word;
    max-height:420px; overflow-y:auto;
  }
  .result-box img { max-width:100%; border-radius:8px; margin-top:8px; display:block; }
  .result-box a { color:#00e5ff; word-break:break-all; }
  .result-box .loading { color:#c800ff; }

  .back-btn {
    display:inline-flex; align-items:center; gap:6px;
    padding:7px 14px; border-radius:10px; margin-bottom:14px;
    background:rgba(20,0,40,0.7);
    border:1px solid rgba(180,0,255,0.3);
    color:#fff; font-size:12px; cursor:pointer; transition:.3s;
  }
  .back-btn:active { border-color:#c800ff; background:rgba(200,0,255,0.15); }

  .btn-logout {
    width:100%; padding:12px; margin-top:16px; border:none; border-radius:12px;
    background:linear-gradient(90deg,#ff0066,#c800ff);
    color:#fff; font-weight:600; font-size:13px;
    cursor:pointer; transition:.3s; letter-spacing:1px;
  }
  .btn-logout:active { transform:scale(0.98); }

  .info-note {
    padding:12px 14px; border-radius:12px;
    background:rgba(0,229,255,0.08);
    border:1px solid rgba(0,229,255,0.3);
    font-size:12px; line-height:1.5; color:#b0e8ff; margin-bottom:14px;
  }
  .info-note b { color:#00e5ff; }

  /* ============== BOTTOM NAV ============== */
  #bottomNav {
    position:absolute; bottom:0; left:0; right:0;
    display:flex; justify-content:space-around; align-items:center;
    padding:8px 4px 10px;
    background:rgba(10,0,20,0.92);
    backdrop-filter:blur(14px);
    border-top:1px solid rgba(180,0,255,0.25);
    box-shadow:0 -4px 30px rgba(200,0,255,0.15);
    z-index:50;
  }
  .nav-item {
    flex:1; display:flex; flex-direction:column; align-items:center; gap:3px;
    padding:6px 2px; cursor:pointer; color:#666;
    transition:.25s; border-radius:10px; user-select:none;
  }
  .nav-item .nav-icon { font-size:20px; line-height:1; transition:.25s; }
  .nav-item .nav-label { font-size:9.5px; font-weight:500; letter-spacing:0.3px; }
  .nav-item.active { color:#fff; }
  .nav-item.active .nav-icon {
    filter:drop-shadow(0 0 8px #c800ff);
    transform:translateY(-2px);
  }
  .nav-item.active .nav-label { color:#fff; font-weight:700; }
</style>
</head>
<body>

<!-- ============ AUTH ============ -->
<div id="authBox">
  <div class="auth-card">
    <div class="auth-avatar">
      <img src="https://h.uguu.se/yTJtlSer.jpg" alt="XyroPlay" onerror="this.style.display='none'">
    </div>
    <div class="auth-title">XyroPlay</div>
    <div class="auth-subtitle">Login atau daftar buat pakai fitur</div>

    <div class="tabs">
      <button class="active" onclick="switchTab('login',this)">Login</button>
      <button onclick="switchTab('register',this)">Daftar</button>
    </div>

    <div class="form-section active" id="loginForm">
      <label class="input-label">Username</label>
      <div class="input-wrap">
        <input type="text" id="loginUser" placeholder="Username" autocomplete="off">
      </div>
      <label class="input-label">Password</label>
      <div class="input-wrap">
        <input type="password" id="loginPass" placeholder="Password">
        <button class="eye-btn" onclick="togglePass('loginPass',this)" type="button">👁</button>
      </div>
      <button class="btn-main" onclick="doLogin()">Login</button>
      <div class="msg" id="loginMsg"></div>
    </div>

    <div class="form-section" id="registerForm">
      <label class="input-label">Username</label>
      <div class="input-wrap">
        <input type="text" id="regUser" placeholder="Username baru" autocomplete="off">
      </div>
      <label class="input-label">Password</label>
      <div class="input-wrap">
        <input type="password" id="regPass" placeholder="Password">
        <button class="eye-btn" onclick="togglePass('regPass',this)" type="button">👁</button>
      </div>
      <label class="input-label">Konfirmasi Password</label>
      <div class="input-wrap">
        <input type="password" id="regPass2" placeholder="Ulangi password">
        <button class="eye-btn" onclick="togglePass('regPass2',this)" type="button">👁</button>
      </div>
      <button class="btn-main" onclick="doRegister()">Daftar</button>
      <div class="msg" id="regMsg"></div>
    </div>

    <div class="auth-footer">
      Password diamankan dengan <b>enkripsi PBKDF2</b>
    </div>
  </div>
</div>

<!-- ============ VIDEO ============ -->
<div id="videoScreen">
  <video id="introVideo" autoplay playsinline>
    <source src="https://n.uguu.se/COuRTRod.mp4" type="video/mp4">
  </video>
  <button id="skipBtn" onclick="skipVideo()">SKIP ⏭</button>
</div>

<!-- ============ APP ============ -->
<div id="app">
  <div id="content">

    <div class="page active" id="page-home">
      <div class="banner-wrap">
        <img src="https://d.uguu.se/PevuJlWl.jpg" alt="Banner">
      </div>
      <div class="user-card">
        <div class="user-avatar" id="userAvatar">A</div>
        <div class="user-info">
          <h3 id="userName">admin</h3>
          <p>Status: Online ⚡</p>
        </div>
      </div>
      <div class="page-title">Selamat Datang 👋</div>
      <div class="page-subtitle">Pilih menu di bawah buat mulai</div>
      <button class="btn-logout" onclick="logout()">Logout</button>
    </div>

    <div class="page" id="page-download">
